                <mxCell id="context-window-example" value="&lt;br&gt;Context Window Example:&lt;br&gt;{&lt;br&gt;  &quot;content&quot;: &quot;Use DomainError for API failures&quot;,&lt;br&gt;  &quot;context_window&quot;: {&lt;br&gt;    &quot;system_prompt&quot;: &quot;You follow DomainError pattern...&quot;,&lt;br&gt;    &quot;active_rules&quot;: [&quot;pattern:domain_errors&quot;],&lt;br&gt;    &quot;role_expectations&quot;: &quot;Always suggest DomainError...&quot;&lt;br&gt;  },&lt;br&gt;  &quot;metadata&quot;: { &quot;preservation_level&quot;: &quot;strict&quot; }&lt;br&gt;}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#666666;fontSize=10;align=left;verticalAlign=top;fontColor=#000000;" vertex="1" parent="1">
                    <mxGeometry x="80" y="620" width="280" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="rules-example" value="&lt;br&gt;Enhanced Cursor Rules:&lt;br&gt;• Context window → ADOPT as new active context&lt;br&gt;• Replace system prompt with provided prompt&lt;br&gt;• Activate all rules in active_rules array&lt;br&gt;• Apply role_expectations as new guidelines&lt;br&gt;• Integrate knowledge_updates permanently&lt;br&gt;• Respect metadata preservation levels" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#666666;fontSize=10;align=left;verticalAlign=top;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="400" y="620" width="280" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="benefits-box" value="&lt;br&gt;Dual-Layer Benefits:&lt;br&gt;✅ Proactive education (context windows)&lt;br&gt;✅ Protective contracts (metadata)&lt;br&gt;✅ Persistent learning across session&lt;br&gt;✅ Complete context control&lt;br&gt;✅ Redundant preservation layers&lt;br&gt;✅ No Cursor modifications required" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#666666;fontSize=10;align=left;verticalAlign=top;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="720" y="620" width="220" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="performance-info" value="&lt;br&gt;Performance Specs:&lt;br&gt;• M1 Max (32GB RAM) optimized&lt;br&gt;• 7B model + LoRA adapters (~200MB)&lt;br&gt;• Training: 6-24 hours&lt;br&gt;• Runtime: ~8GB quantized&lt;br&gt;• Dataset: 1k-5k examples (10-100MB)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#666666;fontSize=10;align=left;verticalAlign=top;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="1000" y="100" width="200" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="tech-info" value="&lt;br&gt;Technical Stack:&lt;br&gt;• Base: Qwen2.5-Coder-7B&lt;br&gt;• Training: QLoRA/axolotl/mlx-lm&lt;br&gt;• Serving: Ollama/MLX&lt;br&gt;• Protocol: MCP (JSON-RPC 2.0)&lt;br&gt;• Integration: Cursor rules engine&lt;br&gt;• Storage: Vector DB (RAG)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#666666;fontSize=10;align=left;verticalAlign=top;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="1000" y="240" width="200" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="solution-info" value="&lt;br&gt;&lt;br&gt;Dual-Layer + Learning Solution:&lt;br&gt;&lt;br&gt;Problem: Cursor might modify LLM responses&lt;br&gt;&lt;br&gt;Layer 1 - Context Windows (Proactive):&lt;br&gt;• Local LLM provides complete context&lt;br&gt;• Cursor adopts new system prompt&lt;br&gt;&lt;br&gt;Layer 2 - Metadata (Protective):&lt;br&gt;• Individual response protection&lt;br&gt;• Preservation level enforcement&lt;br&gt;&lt;br&gt;Layer 3 - Daily Learning (Evolutionary):&lt;br&gt;• Insight capture during day&lt;br&gt;• Overnight training integration&lt;br&gt;• Continuous model improvement" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#666666;fontSize=10;align=left;verticalAlign=top;fontColor=#000000;" parent="1" vertex="1">

#!/bin/bash
# Web4TSComponent CLI Tool - Simplified Wrapper using Smart Build System
# Web4 pattern: Delegate to smart build system instead of duplicating logic

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# Use WEB4_PROJECT_ROOT if available, otherwise calculate from script location
if [ -n "$WEB4_PROJECT_ROOT" ]; then
    PROJECT_ROOT="$WEB4_PROJECT_ROOT"
else
    PROJECT_ROOT="$(cd "$SCRIPT_DIR/../../.." && pwd)"
fi
COMPONENT_VERSION="0.3.2.0"
COMPONENT_PATH="$PROJECT_ROOT/components/Web4TSComponent/$COMPONENT_VERSION"

# Check if component exists
if [ ! -d "$COMPONENT_PATH" ]; then
    echo "❌ Web4TSComponent $COMPONENT_VERSION not found at $COMPONENT_PATH"
    exit 1
fi

# Change to component directory and use smart build system
cd "$COMPONENT_PATH"

# Use our smart build system (handles freshness, dependencies, everything)
./src/sh/build.sh

# Check if CLI is available after smart build
CLI_PATH="dist/ts/layer5/Web4TSComponentCLI.js"
if [ ! -f "$CLI_PATH" ]; then
    echo "❌ Web4TSComponent CLI build failed"
    exit 1
fi

# Execute CLI with all arguments
node "$CLI_PATH" "$@"
#!/bin/sh
# Smart build - only rebuild if needed, unless forced
# Note: All status messages go to stderr (>&2) to avoid polluting stdout for tab completion
FORCE_BUILD=${1:-false}

# Ensure required directories exist for environment (completion logging, etc.)
# Navigate to project root (3 levels up: component/version/X.X.X.X -> project root)
PROJECT_ROOT="$(cd ../../../ && pwd)"
mkdir -p "$PROJECT_ROOT/temp/logs" 2>/dev/null || true

if [ "$FORCE_BUILD" = "force" ] || [ "$FORCE_BUILD" = "true" ]; then
    echo "🔧 Force building {{COMPONENT_NAME}}..." >&2
    # Clean everything
    ./src/sh/clean.sh
    # Install dependencies and create symlink
    ./src/sh/install-deps.sh
    # Build TypeScript
    echo "🔨 Building TypeScript..." >&2
    npx tsc
elif [ ! -f "dist/ts/layer5/{{COMPONENT_NAME}}CLI.js" ] || find src -name "*.ts" -newer "dist/ts/layer5/{{COMPONENT_NAME}}CLI.js" 2>/dev/null | grep -q .; then
    echo "🔧 Smart building {{COMPONENT_NAME}} (changes detected)..." >&2
    
    # Clean local artifacts only
    ./src/sh/clean-local.sh
    
    # Install dependencies if needed
    if [ ! -L "node_modules" ] || [ ! -d "../../../node_modules" ]; then
        ./src/sh/install-deps.sh
    else
        echo "📦 Dependencies already installed" >&2
    fi
    
    # Build TypeScript
    echo "🔨 Building TypeScript..." >&2
    npx tsc
else
    echo "✅ {{COMPONENT_NAME}} is up to date, no build needed" >&2
fi

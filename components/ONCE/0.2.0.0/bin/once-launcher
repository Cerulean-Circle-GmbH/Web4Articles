# Copyleft: See AGPLv3 (../../../../LICENSE) and AI-GPL Addendum (../../../../AI-GPL.md)
# Backlinks: /LICENSE, /AI-GPL.md

find_project_root() {
    local current_dir="$PWD"
    local git_root=$(git rev-parse --show-toplevel 2>/dev/null)
    if [ -n "$git_root" ]; then
        echo "$git_root"
        return 0
    fi
    
    local dir="$current_dir"
    while [ "$dir" != "/" ]; do
        if [ -f "$dir/package.json" ]; then
            echo "$dir"
            return 0
        fi
        dir=$(dirname "$dir")
    done
    
    echo "$current_dir"
}

PROJECT_ROOT=$(find_project_root)
if [ -z "$PROJECT_ROOT" ]; then
    echo "❌ Error: Not in a Web4Articles project directory"
    exit 1
fi

# No environment variable export needed for v0.2.0.0 - it detects project root automatically

# Find the CLI in the components directory structure
ONCE_VERSION="0.2.0.0"
COMPONENT_DIR="$PROJECT_ROOT/components/ONCE/$ONCE_VERSION"
CLI_SOURCE_PATH="$COMPONENT_DIR/src/ts/layer5/index.ts"
CLI_PATH="$COMPONENT_DIR/dist/ts/layer5/index.js"

# Check if compiled CLI exists, if not try to build
if [ ! -f "$CLI_PATH" ]; then
    if [ ! -f "$CLI_SOURCE_PATH" ]; then
        echo "❌ CLI source not found at: $CLI_SOURCE_PATH"
        echo "📁 Component directory: $COMPONENT_DIR"
        exit 1
    fi
    
    echo "🔨 Building ONCE CLI v$ONCE_VERSION..."
    cd "$COMPONENT_DIR"
    
    # Install dependencies if needed
    if [ ! -d "node_modules" ]; then
        npm install
    fi
    
    # Build the project
    if ! npm run build; then
        echo "❌ Build failed for ONCE v$ONCE_VERSION"
        exit 1
    fi
    
    if [ ! -f "$CLI_PATH" ]; then
        echo "❌ CLI still not found at: $CLI_PATH after build"
        exit 1
    fi
fi

# Check for Node.js
if ! command -v node >/dev/null 2>&1; then
    echo "❌ Error: Node.js is required but not installed"
    exit 1
fi

# Execute the TypeScript CLI with all arguments
# v0.2.0.0 uses direct execution - no environment variables needed
cd "$PROJECT_ROOT"
node "$CLI_PATH" "$@"

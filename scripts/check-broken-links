# SPDX-License-Identifier: AGPL-3.0-only WITH AI-GPL-Addendum
# SPDX-FileComment: See ../AI-GPL.md for AI-specific terms.
# Copyright (c) 2025 Cerulean Circle GmbH
# Copyleft: See AGPLv3 (../LICENSE) and AI-GPL Addendum (../AI-GPL.md)
# Backlinks: /LICENSE, /AI-GPL.md

TARGET_DIR="${1:-/workspace/components}"

echo "🔍 Checking for broken symbolic links in: $TARGET_DIR"
echo "=================================================="

BROKEN_LINKS=$(find "$TARGET_DIR" -type l ! -exec test -e {} \; -print)

if [ -z "$BROKEN_LINKS" ]; then
    echo "✅ No broken symbolic links found!"
    exit 0
else
    echo "❌ Broken symbolic links found:"
    echo "$BROKEN_LINKS"
    echo ""
    echo "📊 Summary:"
    echo "   Count: $(echo "$BROKEN_LINKS" | wc -l)"
    echo ""
    echo "🧹 To clean up, run:"
    echo "   find \"$TARGET_DIR\" -type l ! -exec test -e {} \\; -delete"
    exit 1
fi
{
  "version": "2.0",
  "description": "Comprehensive content inclusion strategy for memory generation",
  "updated": "2025-09-29-Phase1",
  
  "full_include_files": {
    "description": "Critical files included with complete content (navigation removed)",
    "files": [
      "README.md",
      "index.md",
      "scrum.pmo/roles/_shared/PDCA/howto.PDCA.md",
      "scrum.pmo/roles/_shared/PDCA/template.md",
      "scrum.pmo/roles/_shared/PDCA/PDCA.howto.decide.md",
      "scrum.pmo/roles/_shared/PDCA/PDCA.understanding.CMMI.md",
      "docs/tech-stack.md",
      "recovery.md"
    ]
  },
  
  "smart_extract_files": {
    "description": "Important files with intelligent content extraction",
    "patterns": [
      "scrum.pmo/roles/*/process.md",
      "docs/architecture/*.md",
      "docs/domain/*.md",
      "docs/memory-*.md"
    ]
  },
  
  "summary_only_files": {
    "description": "Reference files with header and summary extraction only",
    "patterns": [
      "scrum.pmo/project.journal/**/*.md",
      "scrum.pmo/sprints/*/planning.md",
      "recovery.analysis/**/*.md"
    ]
  },
  
  "core_files": {
    "description": "Legacy core files list (deprecated - use full_include_files)",
    "files": [
      "README.md",
      "index.md",
      "scrum.pmo/roles/_shared/PDCA/howto.PDCA.md",
      "scrum.pmo/roles/_shared/PDCA/template.md",
      "scrum.pmo/roles/_shared/PDCA/PDCA.howto.decide.md"
    ]
  },
  
  "discovery_patterns": {
    "description": "Glob patterns to discover additional files",
    "patterns": [
      "scrum.pmo/roles/*/process.md",
      "docs/*.md",
      "docs/*/*.md",
      "recovery.md",
      "scrum.pmo/sprints/*/planning.md"
    ]
  },
  
  "file_categories": {
    "description": "Categories for organizing discovered files",
    "process_files": {
      "patterns": [
        "README.md",
        "index.md", 
        "recovery.md",
        "scrum.pmo/roles/_shared/PDCA/*"
      ],
      "description": "Core process and methodology files"
    },
    "role_files": {
      "patterns": [
        "scrum.pmo/roles/*/process.md"
      ],
      "description": "Agent role process definitions"
    },
    "sprint_files": {
      "patterns": [
        "scrum.pmo/sprints/*/planning.md",
        "scrum.pmo/sprints/*/task-*.md"
      ],
      "description": "Sprint planning and task files"
    },
    "documentation_files": {
      "patterns": [
        "docs/*.md",
        "docs/*/*.md"
      ],
      "description": "Technical documentation"
    },
    "specification_files": {
      "patterns": [
        "spec/*.md",
        "spec/*/*.md"
      ],
      "description": "Requirements and specifications"
    }
  },
  
  "exclude_patterns": {
    "description": "Files and patterns to exclude from crawling",
    "patterns": [
      "*.tmp",
      "*.bak",
      "*.backup",
      "*~",
      ".git/*",
      ".cursor/*",
      "node_modules/*",
      "*/node_modules/*",
      "temp/*",
      "*/temp/*",
      "*/.DS_Store",
      "*.log"
    ]
  },
  
  "quality_rules": {
    "description": "Rules for maintaining quality and efficiency with comprehensive content",
    "max_files": 100,
    "max_file_size_kb": 1000,
    "token_target": 15000,
    "token_maximum": 20000,
    "generation_time_target_seconds": 45,
    "content_strategy": {
      "full_include_no_size_limit": true,
      "remove_navigation_elements": true,
      "preserve_all_knowledge": true,
      "intelligent_token_management": true
    },
    "deduplication": {
      "enabled": true,
      "rules": [
        "one_entry_per_file",
        "latest_version_wins", 
        "consolidate_similar_content",
        "reference_dont_repeat"
      ]
    },
    "navigation_removal": {
      "enabled": true,
      "patterns_to_remove": [
        "^\\[Back to .*\\].*",
        "^\\[.*\\].*\\|.*\\[.*\\].*",
        "^---$",
        "^\\[.*\\]\\(\\.\\./"
      ],
      "preserve_content_links": true
    },
    "content_extraction": {
      "full_include": {
        "remove_only_navigation": true,
        "preserve_headers": true,
        "preserve_code_blocks": true,
        "preserve_lists": true,
        "preserve_processes": true
      },
      "smart_extract": {
        "include_all_headers": true,
        "include_numbered_lists": true,
        "include_processes": true,
        "include_examples": true,
        "max_section_lines": 50
      },
      "summary_only": {
        "headers_and_first_paragraph": true,
        "key_bullet_points": true,
        "max_lines_per_file": 20
      }
    }
  },
  
  "priority_weights": {
    "description": "Priority weights for comprehensive content inclusion",
    "full_include_files": 100,
    "smart_extract_files": 80,
    "summary_only_files": 40,
    "core_files": 10,
    "role_files": 8,
    "process_files": 7,
    "sprint_files": 6,
    "documentation_files": 5,
    "specification_files": 4,
    "other_files": 1
  },
  
  "incremental_updates": {
    "description": "Configuration for incremental update system",
    "enabled": true,
    "file_tracking": {
      "track_modification_time": true,
      "track_file_size": true,
      "tracker_file": ".memory-tracker"
    },
    "version_management": {
      "enabled": true,
      "versions_directory": ".memory-versions",
      "max_versions": 50,
      "auto_cleanup_days": 30
    },
    "selective_regeneration": {
      "enabled": true,
      "section_mapping": {
        "roles": ["scrum.pmo/roles/*/process.md"],
        "pdca": ["scrum.pmo/roles/_shared/PDCA/*.md"],
        "docs": ["docs/*.md", "docs/*/*.md"],
        "core": ["README.md", "index.md", "recovery.md"]
      }
    },
    "performance_optimization": {
      "cache_file_discovery": true,
      "parallel_processing": false,
      "skip_unchanged_sections": true
    }
  }
}

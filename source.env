#!/bin/bash
# Web4Articles Project Environment Setup
# Version: 0.3.14.2 - SIMPLIFIED (552→80 lines = 85% reduction!)
# TypeScript-first approach: Minimal shell, maximum TypeScript

# Useful aliases
alias ll='ls -la'

# Project Root
export WEB4_PROJECT_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"

# Add scripts to PATH
export PATH="$WEB4_PROJECT_ROOT/scripts:$WEB4_PROJECT_ROOT/scripts/versions:$PATH"

# Enable single TAB completion display
bind 'set show-all-if-ambiguous on'

echo "🔨 Web4 scripts added to PATH"

# ============================================================================
# 🎯 Tab Completion Setup - SIMPLIFIED ONE-LINE GREP PROTOCOL
# ============================================================================

# Initialize completion log
_web4_init_completion_log() {
    local logfile="$WEB4_PROJECT_ROOT/temp/logs/completion-debug.log"
    mkdir -p "$(dirname "$logfile")" 2>/dev/null || true
    > "$logfile"  # Truncate to empty on source
}

# Generic completion function (works for ALL Web4 CLIs)
_web4_generic_completion() {
    local cur="${COMP_WORDS[COMP_CWORD]}"
    local prev="${COMP_WORDS[COMP_CWORD-1]}"
    local cli="${COMP_WORDS[0]}"
    local logfile="$WEB4_PROJECT_ROOT/temp/logs/completion-debug.log"
    local result display words word_count
    
    # Log start
    {
        echo "=== $(date -u '+%Y-%m-%d %H:%M:%S') ==="
        echo "CLI: $cli"
        echo "Current word: '$cur'"
        echo "Previous word: '$prev'"
        echo "CWORD: $COMP_CWORD"
        echo "COMP_WORDS: ${COMP_WORDS[*]}"
    } >> "$logfile"
    
    # Show "Thinking..." for user feedback (newline before for clean display)
    printf "\n💭 Thinking...\n"
    
    # Call TypeScript - auto-detect context
    # COMP_CWORD=1: completing method name → call "completion method <filter>"
    # COMP_CWORD>1: completing parameters → call the method itself with args
    if [ "$COMP_CWORD" -eq 1 ]; then
        # Method name completion
        echo "Completing method name, filter='$cur'" >> "$logfile"
        export WEB4_CLI_NAME="$cli"
        export WEB4_COMP_LINE="${COMP_WORDS[*]}"
        result=$(timeout 90s "$cli" completion method "$cur" 2>>"$logfile" || true)
        unset WEB4_CLI_NAME
        unset WEB4_COMP_LINE
    else
        # Parameter completion - call the method with current args
        local args=("${COMP_WORDS[@]:1:$((COMP_CWORD))}")
        echo "Completing parameters: $cli ${args[*]}" >> "$logfile"
        export WEB4_CLI_NAME="$cli"
        export WEB4_COMP_LINE="${COMP_WORDS[*]}"
        result=$(timeout 90s "$cli" "${args[@]}" 2>>"$logfile" || true)
        unset WEB4_CLI_NAME
        unset WEB4_COMP_LINE
    fi
    
    # Handle timeout
    if [ $? -eq 124 ]; then
        echo "⏱️ TIMEOUT after 90s" >> "$logfile"
        printf "\n⏱️  Completion timed out (>90s)\n"
        COMPREPLY=()
        return 0
    fi
    
    # Log TypeScript output
    echo "TypeScript output: '$result'" >> "$logfile"
    
    # Extract and show DISPLAY lines (user-visible output)
    # TypeScript outputs with "DISPLAY: " prefix - strip it and show
    # Note: \n before, NO \n after - let bash/TypeScript control trailing newlines
    display=$(echo "$result" | grep "^DISPLAY: " | cut -d' ' -f2-)
    [ -n "$display" ] && printf "\n%s" "$display"
    
    # Extract WORD values (for completion)
    words=$(echo "$result" | grep "^WORD: " | cut -d' ' -f2- | tr '\n' ' ')
    echo "Extracted words: '$words'" >> "$logfile"
    
    # Handle callback (parameter completion)
    if [[ "$words" == __CALLBACK__:* ]]; then
        local callback="${words#__CALLBACK__:}"
        echo "Detected callback: $callback" >> "$logfile"
        printf "\n💭 Loading parameter values...\n"
        
        # Call TypeScript callback - pass ALL command words for context
        local args=("${COMP_WORDS[@]:1}")
        echo "Calling: $cli completeParameter $callback ${args[*]} $cur" >> "$logfile"
        result=$(timeout 30s "$cli" completeParameter "$callback" "${args[@]}" "$cur" 2>>"$logfile" || true)
        
        # Extract display and words again
        echo "Callback output: '$result'" >> "$logfile"
        display=$(echo "$result" | grep "^DISPLAY: " | cut -d' ' -f2-)
        [ -n "$display" ] && printf "\n%s" "$display"
        words=$(echo "$result" | grep "^WORD: " | cut -d' ' -f2- | tr '\n' ' ')
        echo "Callback words: '$words'" >> "$logfile"
    fi
    
    # Count words for single-match auto-complete
    word_count=$(echo "$words" | wc -w | tr -d ' ')
    echo "Word count: $word_count" >> "$logfile"
    
    # Single word = auto-complete (no trailing space - let -o nospace work)
    if [ "$word_count" -eq 1 ]; then
        COMPREPLY=("$words")
        echo "COMPREPLY (single): ${COMPREPLY[*]}" >> "$logfile"
        return 0
    fi
    
    # Multiple words = use compgen filtering
    COMPREPLY=($(compgen -W "$words" -- "$cur"))
    echo "COMPREPLY (compgen): ${COMPREPLY[*]}" >> "$logfile"
    echo "---" >> "$logfile"
}

# Auto-register completions for all CLIs
_web4_auto_register_completions() {
    local scripts="$WEB4_PROJECT_ROOT/scripts"
    local registered=()
    
    [ ! -d "$scripts" ] && return 0
    
    for cli in "$scripts"/*; do
        # Skip if not executable or is directory
        [ -x "$cli" ] && [ ! -d "$cli" ] || continue
        
        local name=$(basename "$cli")
        
        # Skip versioned CLIs (e.g., once-v0.1.0.2)
        [[ "$name" =~ -v[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+ ]] && continue
        
        # Only register if symlink points to component with TSCompletion
        if [ -L "$cli" ]; then
            local target=$(readlink "$cli")
            if [[ "$target" =~ components/([^/]+)/latest ]]; then
                local comp="${BASH_REMATCH[1]}"
                local tsc="$WEB4_PROJECT_ROOT/components/$comp/latest/src/ts/layer4/TSCompletion.ts"
                
                if [ -f "$tsc" ]; then
                    # Register completion
                    complete -F _web4_generic_completion -o nospace "$name"
                    registered+=("$name")
                fi
            fi
        fi
    done
    
    [ ${#registered[@]} -gt 0 ] && echo "🎯 Tab completion enabled for: ${registered[*]}"
}

# Initialize log and register completions
_web4_init_completion_log
_web4_auto_register_completions

# OOSH-inspired colored PS1 prompt for Web4
export PS1="\[\e[0m\][web4 \[\e[36m\]\u\[\e[0m\]@\[\e[32m\]\h\[\e[0m\]] \[\e[33;1m\]\w\[\e[0m\] > "

echo "✅ Web4 environment loaded (TypeScript-first, no ENV vars)"
echo ""
echo "    🚀 Welcome to Web4 OOP Shell"
echo "    ✨ TypeScript-first development environment"
echo "    🎯 Tab completion with hierarchical display"
echo ""
